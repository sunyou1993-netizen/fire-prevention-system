---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** 추가 구조화 데이터 (JSON-LD) */
  schema?: Record<string, unknown>[];
  /** 주방 솔루션 Service 스키마 포함 여부 (메뉴 하위 페이지는 false) */
  service?: boolean;
}

const { title = site.seo.title, description = site.seo.description, ogImage = site.seo.ogImage, schema = [], service = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.company,
    alternateName: site.brand,
    url: site.homepage,
    telephone: site.tel,
    email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: site.address, addressCountry: 'KR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: '단체급식 주방 화재 예방 + 공기질 통합관리 솔루션',
    serviceType: '주방 화재 예방 시스템',
    description,
    provider: { '@type': 'Organization', name: site.company, url: site.homepage },
    areaServed: 'KR',
    audience: { '@type': 'BusinessAudience', name: '급식 운영사, 기업, 학교, 병원, 공공기관' },
    url: canonical,
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:site_name" content={`${site.brand} ${site.company}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {site.seo.googleVerification && <meta name="google-site-verification" content={site.seo.googleVerification} />}
    {site.seo.naverVerification && <meta name="naver-site-verification" content={site.seo.naverVerification} />}

    {[...(service ? baseSchema : baseSchema.slice(0, 1)), ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <slot />
  </body>
</html>
