---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  download?: boolean;
  class?: string;
}
const { href, variant = 'primary', download = false, class: cls } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, cls]} download={download || undefined}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 650;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }
  .btn--primary {
    background: var(--grib-blue);
    color: var(--white);
  }
  .btn--primary:hover {
    background: var(--grib-blue-deep);
  }
  .btn--secondary {
    background: var(--white);
    color: var(--charcoal);
    box-shadow: inset 0 0 0 1.5px var(--line);
  }
  .btn--secondary:hover {
    box-shadow: inset 0 0 0 1.5px var(--cool-gray-light);
  }
</style>
